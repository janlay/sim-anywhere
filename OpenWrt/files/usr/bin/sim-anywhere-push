#!/usr/bin/python3
"""Send one short-lived VoIP push per registered device for an incoming call."""

import base64
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time

from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import ec
from cryptography.hazmat.primitives.asymmetric.utils import decode_dss_signature

KEY = "/etc/sim-anywhere-apns-key.p8"
DEVICES = "/root/sim-anywhere-voip-tokens.json"
LOCK = "/var/lock/sim-anywhere-voip-tokens.lock"
DELIVERY = "/root/sim-anywhere-voip-delivery.json"


def config_value(name):
    result = subprocess.run(["uci", "-q", "get", "dongle.push." + name],
                            capture_output=True, text=True, timeout=2)
    if result.returncode != 0:
        raise ValueError("missing APNs setting")
    return result.stdout.strip()


def load_config():
    config = {"team_id": config_value("team_id"), "key_id": config_value("key_id"),
              "bundle_id": config_value("bundle_id"), "private_key_path": KEY}
    if not re.fullmatch(r"[A-Z0-9]{10}", config["team_id"]):
        raise ValueError("invalid team ID")
    if not re.fullmatch(r"[A-Z0-9]{10}", config["key_id"]):
        raise ValueError("invalid key ID")
    if not re.fullmatch(r"[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+", config["bundle_id"]):
        raise ValueError("invalid bundle ID")
    return config


def fingerprint(config, device):
    key = os.stat(config["private_key_path"])
    fields = [config["team_id"], config["key_id"], config["bundle_id"],
              str(key.st_ino), str(key.st_mtime_ns), device["token"], device["environment"]]
    return hashlib.sha256("\0".join(fields).encode()).hexdigest()


def delivery_status(device_id, bundle_id, environment):
    try:
        config = load_config()
        if not os.path.isfile(KEY):
            return "unconfigured"
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return "unconfigured"
    if config["bundle_id"] != bundle_id:
        return "ineffective"
    try:
        bearer(config)  # Check that the installed key can sign an APNs provider token.
        with open(DEVICES) as source:
            devices = json.load(source)
        device = next((d for d in devices if d["device"] == device_id), None)
        if device is None or device["environment"] != environment:
            return "ineffective"
        with open(DELIVERY) as source:
            deliveries = json.load(source)
        accepted = deliveries.get(device_id)
        if accepted == fingerprint(config, device):
            return "active"
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return "ineffective"


def record_delivery(device, config, code):
    try:
        with open(LOCK, "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                with open(DELIVERY) as source:
                    deliveries = json.load(source)
            except (OSError, ValueError):
                deliveries = {}
            if code == 200:
                deliveries[device["device"]] = fingerprint(config, device)
            else:
                deliveries.pop(device["device"], None)
            pending = DELIVERY + ".tmp"
            fd = os.open(pending, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w") as target:
                json.dump(deliveries, target)
            os.replace(pending, DELIVERY)
    except (OSError, ValueError, KeyError, TypeError):
        pass


def b64(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode("ascii")


def bearer(config):
    with open(config["private_key_path"], "rb") as f:
        key = serialization.load_pem_private_key(f.read(), password=None)
    head = b64(json.dumps({"alg": "ES256", "kid": config["key_id"]}, separators=(",", ":")).encode())
    body = b64(json.dumps({"iss": config["team_id"], "iat": int(time.time())}, separators=(",", ":")).encode())
    signed = (head + "." + body).encode()
    der = key.sign(signed, ec.ECDSA(hashes.SHA256()))
    r, s = decode_dss_signature(der)
    return head + "." + body + "." + b64(r.to_bytes(32, "big") + s.to_bytes(32, "big"))


def send(device, call_id, config, auth):
    host = "api.sandbox.push.apple.com" if device["environment"] == "development" else "api.push.apple.com"
    url = "https://%s/3/device/%s" % (host, device["token"])
    with tempfile.NamedTemporaryFile(mode="w", prefix="sim-anywhere-apns-", delete=False) as f:
        f.write('header = "authorization: bearer %s"\n' % auth)
        path = f.name
    try:
        p = subprocess.run([
            "curl", "--config", path, "--http2", "--silent", "--show-error", "--max-time", "8",
            "--request", "POST", "--header", "apns-push-type: voip",
            "--header", "apns-topic: %s.voip" % config["bundle_id"],
            "--header", "apns-priority: 10", "--header", "apns-expiration: 0",
            "--header", "content-type: application/json", "--output", "/dev/null",
            "--write-out", "%{http_code}", "--data-binary", json.dumps({"call_id": call_id}), url,
        ], capture_output=True, text=True, timeout=10)
    finally:
        os.unlink(path)
    return int(p.stdout or 0) if p.returncode == 0 else 0


def remove_invalid(ids):
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with open(DEVICES) as f:
                devices = json.load(f)
            kept = [d for d in devices if d["device"] not in ids]
            if len(kept) != len(devices):
                tmp = DEVICES + ".tmp"
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "w") as f:
                    json.dump(kept, f)
                os.replace(tmp, DEVICES)
        except OSError:
            pass


def main(call_id):
    if not re.fullmatch(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}", call_id):
        raise ValueError("invalid call ID")
    try:
        with open(DEVICES) as f:
            devices = json.load(f)
        if not devices:
            return
        config = load_config()
        auth = bearer(config)
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired) as e:
        print("VoIP push is not configured:", type(e).__name__, file=sys.stderr)
        return
    invalid = set()
    for device in devices:
        try:
            code = send(device, call_id, config, auth)
            record_delivery(device, config, code)
            if code in (410,):
                invalid.add(device["device"])
            elif code != 200:
                print("APNs status", code, file=sys.stderr)
        except (OSError, subprocess.TimeoutExpired, KeyError, ValueError):
            record_delivery(device, config, 0)
            print("APNs delivery failed", file=sys.stderr)
    if invalid:
        remove_invalid(invalid)


if __name__ == "__main__":
    if len(sys.argv) == 5 and sys.argv[1] == "status":
        print(json.dumps({"state": delivery_status(sys.argv[2], sys.argv[3], sys.argv[4])}))
    elif len(sys.argv) == 2:
        main(sys.argv[1])
    else:
        sys.exit("usage: sim-anywhere-push <call-id> | status <device-id> <bundle-id> <environment>")
