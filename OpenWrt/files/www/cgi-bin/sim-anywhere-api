/* ---------- clash proxy groups (integration auto-detected; see /usr/bin/dongle-clash) ---------- */
// helper exit codes: 0 ok; 3 clash not integrated or no 4G exit proxy; anything else carries {"error"}
function clash(args) {
	let p = fs.popen('/usr/bin/dongle-clash ' + args), out = trim(p.read('all') || ''), rc = p.close();
	let d = null;
	try { d = json(out); } catch (e) {}
	return { rc, msg: (type(d) == 'object' && d.error) ? d.error : out, data: d };
}
if (r0 == 'proxy' && r1 == 'status' && PATH[2] == null) {
	if (METHOD != 'GET') fail(405, 'method not allowed');
	let c = clash('status');
	if (c.rc != 0) fail(502, c.msg || 'clash helper failed');
	reply(200, c.data);
}
if (r0 == 'proxy' && r1 == 'groups' && PATH[2] == null) {
	if (METHOD != 'GET') fail(405, 'method not allowed');
	let c = clash('groups');
	if (c.rc == 3) fail(503, c.msg);
	if (c.rc != 0) fail(502, c.msg || 'clash helper failed');
	reply(200, c.data);
}
if (r0 == 'proxy' && r1 == 'select' && PATH[2] == null) {
	if (METHOD != 'POST') fail(405, 'method not allowed');
	let b = body(), group = b.group, proxy = b.proxy;
	if (type(group) != 'string' || group == '' || type(proxy) != 'string' || proxy == '')
		fail(400, 'group and proxy must be non-empty strings');
	let c = clash('set ' + sq(group) + ' ' + sq(proxy));
	if (c.rc == 3) fail(503, c.msg);
	if (c.rc != 0) fail(502, c.msg || 'clash helper failed');
	reply(200, { ok: true });
}
if (r0 == 'proxy' && r1 == 'ping' && PATH[2] == null) {
	if (METHOD != 'POST') fail(405, 'method not allowed');
	// Optional body {"proxy": name}; without it (or with {}) the 4G exit proxy is tested.
	let args = 'ping';
	let b = body();
	if (b != null) {
		if (type(b) != 'object' || (b.proxy != null && (type(b.proxy) != 'string' || b.proxy == '')))
			fail(400, 'proxy must be a non-empty string');
		if (type(b.proxy) == 'string') args += ' ' + sq(b.proxy);
	}
	let c = clash(args);
	if (c.rc == 3) fail(503, c.msg);
	if (c.rc != 0) fail(502, c.msg || 'clash helper failed');
	reply(200, c.data);
}
if (r0 == 'proxy' && r1 == 'test' && PATH[2] == null) {
	if (METHOD != 'POST') fail(405, 'method not allowed');
	// Optional body {"group": name}; without it (or with {}) every listed group is tested.
	let args = 'test';
	let b = body();
	if (b != null) {
		if (type(b) != 'object' || (b.group != null && (type(b.group) != 'string' || b.group == '')))
			fail(400, 'group must be a non-empty string');
		if (type(b.group) == 'string') args += ' ' + sq(b.group);
