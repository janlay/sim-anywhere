#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=05

start_service() {
    # Idle (both limits off, mobile data on): no instance. Attach the modem once, so a block
    # left by a stopped instance does not stay. The instance is started again on a UCI change.
    if /usr/bin/sim-anywhere-quota idle; then
        /usr/bin/sim-anywhere-quota release
        return 0
    fi
    # Runs without the modem too: it counts nothing and keeps the last state until one appears.
    procd_open_instance
    procd_set_param command /usr/bin/python3 -u /usr/bin/sim-anywhere-quota
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/sim-anywhere-quota.pid
    procd_close_instance
}

reload_service() {
    restart
}

# Registered at boot, so a change of the dongle UCI config restarts the service even when it was idle.
service_triggers() {
    procd_add_reload_trigger dongle
}
