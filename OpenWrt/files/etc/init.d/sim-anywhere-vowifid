#!/bin/sh /etc/rc.common
# sim-anywhere-vowifid: Wi-Fi Calling (IMS over the internet). It authenticates with the SIM through
# the modem, so it runs only while the dongle is on the USB bus; /etc/hotplug.d/usb/31-dongle-services
# starts it on insert and stops it on remove.
USE_PROCD=1
START=95
STOP=10

start_service() {
    /usr/bin/dongle-present || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 -u /usr/bin/sim-anywhere-vowifid
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/sim-anywhere-vowifid.pid
    procd_set_param term_timeout 20
    procd_close_instance
}
