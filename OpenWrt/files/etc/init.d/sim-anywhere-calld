#!/bin/sh /etc/rc.common
# sim-anywhere-calld: voice calls through the 4G dongle (WebSocket :8765/call)
# Starts only while the modem is on the USB bus. /etc/hotplug.d/usb/31-dongle-services
# starts it when the dongle is plugged in and stops it when it is removed.
START=99
USE_PROCD=1

start_service() {
	/usr/bin/dongle-present || return 0
	procd_open_instance
	procd_set_param command /usr/bin/sim-anywhere-calld
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
